{
  "name": "@aylith/inspekt-vite",
  "version": "0.2.1",
  "description": "Inspekt Vite plugin — injects source location attributes at build time",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./webpack": {
      "types": "./dist/unplugin.d.ts",
      "import": "./dist/unplugin.js",
      "require": "./dist/unplugin.cjs"
    },
    "./rspack": {
      "types": "./dist/unplugin.d.ts",
      "import": "./dist/unplugin.js",
      "require": "./dist/unplugin.cjs"
    },
    "./esbuild": {
      "types": "./dist/unplugin.d.ts",
      "import": "./dist/unplugin.js",
      "require": "./dist/unplugin.cjs"
    },
    "./rolldown": {
      "types": "./dist/unplugin.d.ts",
      "import": "./dist/unplugin.js",
      "require": "./dist/unplugin.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --outDir dist --rootDir src",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aylith/inspekt-core": "workspace:*",
    "@aylith/inspekt-cli": "workspace:*",
    "@code-inspector/core": "^2.0.7",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vite": "^8.2.0",
    "@types/node": "^26.1.2"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
