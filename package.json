{
  "name": "inspekt",
  "private": true,
  "description": "Framework-agnostic element inspector for developers",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "playground",
    "site"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "turbo run clean",
    "site:dev": "cd site && bun run docs:dev",
    "site:build": "cd site && bun run docs:build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "zod": "^4.4.3"
  }
}
